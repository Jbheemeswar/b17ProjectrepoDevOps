class Solution {
    public int minFallingPathSum(int[][] matrix) {
        int n = matrix.length;
        
        for (int row = 1; row < n; row++) {
            for (int col = 0; col < n; col++) {
                
                
                int minAbove = matrix[row - 1][col];
                
                if (col > 0) {
                    minAbove = Math.min(minAbove, matrix[row - 1][col - 1]);
                }
                
               
                if (col < n - 1) {
                    minAbove = Math.min(minAbove, matrix[row - 1][col + 1]);
                }
                
                
                matrix[row][col] += minAbove;
            }
        }
        
        
        int minSum = Integer.MAX_VALUE;
        for (int col = 0; col < n; col++) {
            minSum = Math.min(minSum, matrix[n - 1][col]);
        }
        
        return minSum;
    }
}
